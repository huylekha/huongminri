---
import type { Locale } from '../data/services';
import { t } from '../i18n/translations';

interface Props { 
  lang: Locale;
  title?: string;
  description?: string;
  compact?: boolean;
}

const { lang, title, description, compact = false } = Astro.props;
---

<div class={`social-share ${compact ? 'social-share-compact' : ''}`}>
  {!compact && <span class="share-label">{t(lang, 'share.label') || 'Chia sẻ:'}</span>}
  
  <div class="share-buttons">
    <button type="button" class="share-btn share-facebook" data-share="facebook" aria-label="Share on Facebook">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
      {!compact && <span>Facebook</span>}
    </button>

    <button type="button" class="share-btn share-twitter" data-share="twitter" aria-label="Share on Twitter">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
      </svg>
      {!compact && <span>Twitter</span>}
    </button>

    <button type="button" class="share-btn share-whatsapp" data-share="whatsapp" aria-label="Share on WhatsApp">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.520-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
      </svg>
      {!compact && <span>WhatsApp</span>}
    </button>

    <button type="button" class="share-btn share-native" data-share="native" aria-label="Share" title="Share" style="display:none;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
      </svg>
      {!compact && <span>Share</span>}
    </button>

    <button type="button" class="share-btn share-copy" data-share="copy" aria-label="Copy link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      </svg>
      {!compact && <span>Copy</span>}
    </button>
  </div>
</div>

<style>
  .social-share { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .social-share-compact { gap: var(--space-2); }
  
  .share-label { font-size: 0.88rem; color: var(--color-text-soft); white-space: nowrap; }
  
  .share-buttons { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  
  .share-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 12px; border-radius: var(--radius-pill);
    font-size: 0.85rem; font-weight: 500;
    background: var(--color-bg); border: 1px solid var(--color-border);
    color: var(--color-text-soft);
    transition: all var(--dur) var(--ease);
    cursor: pointer;
  }
  .social-share-compact .share-btn { padding: 8px; }
  .social-share-compact .share-btn span { display: none; }
  
  .share-btn:hover { 
    transform: translateY(-2px); 
    box-shadow: var(--shadow-md);
    color: var(--color-text);
  }
  
  .share-facebook:hover { background: #1877f2; color: #fff; border-color: #1877f2; }
  .share-twitter:hover { background: #1da1f2; color: #fff; border-color: #1da1f2; }
  .share-whatsapp:hover { background: #25d366; color: #fff; border-color: #25d366; }
  .share-native:hover { background: var(--color-primary); color: #fff; border-color: var(--color-primary); }
  .share-copy:hover { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }

  /* Success state for copy button */
  .share-copy.copied { background: #22c55e; color: #fff; border-color: #22c55e; }
</style>

<script>
  import { SocialShare, trackSocialShare } from '../lib/social.js';

  // Initialize social sharing
  document.addEventListener('DOMContentLoaded', () => {
    // Show native share button if supported
    if (navigator.share) {
      const nativeBtn = document.querySelector('.share-native') as HTMLElement;
      if (nativeBtn) nativeBtn.style.display = 'inline-flex';
    }

    // Handle share button clicks
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const shareBtn = target.closest<HTMLButtonElement>('[data-share]');
      if (!shareBtn) return;

      const platform = shareBtn.dataset.share;
      if (!platform) return;

      // Get share data
      const shareData = SocialShare.getDefaultShareData(document.documentElement.lang || 'vi');

      // Handle different sharing methods
      switch (platform) {
        case 'facebook':
          window.open(SocialShare.facebook(shareData), '_blank', 'width=600,height=400');
          break;
        case 'twitter':
          window.open(SocialShare.twitter(shareData), '_blank', 'width=600,height=400');
          break;
        case 'whatsapp':
          window.open(SocialShare.whatsapp(shareData), '_blank');
          break;
        case 'native':
          SocialShare.nativeShare(shareData);
          break;
        case 'copy':
          copyLink(shareBtn, shareData.url);
          break;
      }

      // Track sharing event
      trackSocialShare(platform);
    });

    // Copy link function
    async function copyLink(button: HTMLButtonElement, url: string) {
      try {
        await navigator.clipboard.writeText(url);
        
        // Visual feedback
        const originalText = button.innerHTML;
        button.classList.add('copied');
        button.innerHTML = button.innerHTML.replace('Copy', 'Copied!');
        
        setTimeout(() => {
          button.classList.remove('copied');
          button.innerHTML = originalText;
        }, 2000);
        
      } catch (err) {
        console.warn('Failed to copy link:', err);
        // Fallback: select text manually
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
      }
    }
  });
</script>