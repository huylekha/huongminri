---
import type { Locale } from '../data/services';
import { combos, formatPrice, tx } from '../data/services';
import { t } from '../i18n/translations';

interface Props { lang: Locale }
const { lang } = Astro.props;
---
<section class="section combos" aria-labelledby="combos-title">
  <div class="container">
    <div class="section-title">
      <span class="section-eyebrow">{t(lang, 'combo.eyebrow')}</span>
      <h2 id="combos-title">{t(lang, 'combo.title')}</h2>
      <p>{t(lang, 'combo.lead')}</p>
    </div>

    <div class="combo-grid">
      {combos.map((c) => {
        const savings = c.originalPrice - c.comboPrice;
        return (
          <article class={`combo-card combo-${c.group}`}>
            {c.badge && <span class="badge badge-popular combo-badge">{tx(c.badge, lang)}</span>}
            <h3 class="combo-name">{tx(c.name, lang)}</h3>
            <p class="combo-desc">{tx(c.description, lang)}</p>
            <div class="combo-prices">
              <span class="combo-original">{t(lang, 'combo.original')}: <s>{formatPrice(c.originalPrice)}</s></span>
              <div class="combo-now">
                <span class="combo-now-label">{t(lang, 'combo.combo')}</span>
                <span class="combo-now-price">{formatPrice(c.comboPrice)}</span>
              </div>
              {savings > 0 && <span class="combo-save">−{formatPrice(savings)}</span>}
            </div>
            <button type="button" class="btn btn-primary combo-cta" data-open-booking data-service={c.id}>
              {t(lang, 'pricing.book')}
            </button>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .combos { background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%); }
  .combo-grid {
    display: grid; gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .combo-grid { grid-template-columns: repeat(3, 1fr); } }

  .combo-card {
    position: relative;
    background: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .combo-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .combo-herbal_spa { border-top: 4px solid var(--color-primary); }
  .combo-nail_services { border-top: 4px solid var(--color-accent); }

  .combo-badge { position: absolute; top: -12px; left: 24px; }
  .combo-name { font-family: var(--font-title); margin: 0 0 var(--space-2); }
  .combo-desc { color: var(--color-text-soft); margin-bottom: var(--space-4); flex-grow: 1; font-size: 0.92rem; }

  .combo-prices { display: flex; flex-direction: column; gap: 4px; margin-bottom: var(--space-4); }
  .combo-original { font-size: 0.85rem; color: var(--color-text-muted); }
  .combo-now { display: flex; align-items: baseline; gap: var(--space-2); }
  .combo-now-label { font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted); }
  .combo-now-price { font-family: var(--font-title); font-weight: 700; font-size: 2rem; color: var(--color-primary); line-height: 1; }
  .combo-nail_services .combo-now-price { color: var(--color-accent-dark); }

  .combo-save {
    align-self: flex-start; margin-top: 4px;
    font-size: 0.78rem; font-weight: 700;
    color: var(--color-popular);
    background: rgba(224,120,86,0.1);
    padding: 2px 10px; border-radius: var(--radius-pill);
  }

  .combo-cta { width: 100%; justify-content: center; }
</style>
