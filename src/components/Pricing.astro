---
import type { Locale, Service, ServiceGroup } from '../data/services';
import {
  categoriesByGroup, servicesByCategory, recommendedHerbalSpa,
  formatPriceRange, tx,
} from '../data/services';
import { t } from '../i18n/translations';

interface Props { lang: Locale }
const { lang } = Astro.props;

// Recommended Herbal Spa (top 4)
const recommended = recommendedHerbalSpa();

// All non-recommended Herbal Spa categories (collapsed by default)
const spaCats = categoriesByGroup('herbal_spa').filter((c) => c.id !== 'recommended');
const nailCats = categoriesByGroup('nail_services');

const badgeFor = (s: Service): { cls: string; label: string } | null => {
  if (!s.tag) return null;
  if (s.tag === 'popular' || s.tag === 'recommended') return { cls: 'badge-popular', label: t(lang, 'badge.popular') };
  if (s.tag === 'best') return { cls: 'badge-best', label: t(lang, 'badge.best') };
  if (s.tag === 'vip') return { cls: 'badge-vip', label: t(lang, 'badge.vip') };
  return null;
};
---
<section id="pricing" class="section pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="section-title">
      <span class="section-eyebrow">{t(lang, 'pricing.eyebrow')}</span>
      <h2 id="pricing-title">{t(lang, 'pricing.title')}</h2>
      <p>{t(lang, 'pricing.lead')}</p>
    </div>

    <!-- Tab toggle -->
    <div class="tabs" role="tablist" aria-label="Service groups">
      <button role="tab" class="tab tab-active" data-tab="herbal_spa" aria-selected="true" id="tab-spa" aria-controls="panel-spa">
        {t(lang, 'pricing.tab.spa')}
      </button>
      <button role="tab" class="tab" data-tab="nail_services" aria-selected="false" id="tab-nail" aria-controls="panel-nail">
        {t(lang, 'pricing.tab.nail')}
      </button>
      <span class="tab-indicator" aria-hidden="true"></span>
    </div>

    <!-- HERBAL SPA PANEL -->
    <div id="panel-spa" role="tabpanel" aria-labelledby="tab-spa" class="panel panel-active" data-panel="herbal_spa">
      <span id="pricing-spa" class="anchor"></span>

      <!-- Recommended (top, always visible, big cards) -->
      <div class="recommended">
        <div class="recommended-header">
          <h3>{t(lang, 'pricing.recommended')}</h3>
          <p>{t(lang, 'pricing.recommended.lead')}</p>
        </div>
        <div class="recommended-grid">
          {recommended.map((s) => {
            const badge = badgeFor(s);
            const tagClass = `rec-card${s.tag ? ` rec-${s.tag}` : ''}`;
            return (
              <article class={tagClass}>
                {badge && <span class={`badge ${badge.cls} rec-badge`}>{badge.label}</span>}
                <h4 class="rec-name">{tx(s.name, lang)}</h4>
                {s.duration && <span class="rec-duration">{s.duration}</span>}
                <div class="rec-price">{formatPriceRange(s)}</div>
                <p class="rec-desc">{tx(s.description, lang)}</p>
                <button type="button" class="btn btn-primary rec-cta" data-open-booking data-service={s.id}>
                  {t(lang, 'pricing.book')}
                </button>
              </article>
            );
          })}
        </div>
      </div>

      <!-- Other categories — accordion -->
      <div class="accordion">
        {spaCats.map((cat, i) => {
          const items = servicesByCategory('herbal_spa', cat.id);
          if (items.length === 0) return null;
          return (
            <details class="accordion-item" open={i === 0 ? true : undefined}>
              <summary class="accordion-summary">
                <span>{tx(cat.name, lang)}</span>
                <span class="accordion-count">{items.length}</span>
                <span class="accordion-icon" aria-hidden="true">+</span>
              </summary>
              <ul class="service-list">
                {items.map((s) => {
                  const badge = badgeFor(s);
                  return (
                    <li class="service-row">
                      <div class="service-row-main">
                        <div class="service-row-head">
                          <span class="service-row-name">{tx(s.name, lang)}</span>
                          {badge && <span class={`badge ${badge.cls}`}>{badge.label}</span>}
                        </div>
                        <p class="service-row-desc">{tx(s.description, lang)}</p>
                        {s.duration && <span class="service-row-duration">{s.duration}</span>}
                      </div>
                      <div class="service-row-side">
                        <div class="service-row-price">{formatPriceRange(s)}</div>
                        <button type="button" class="btn btn-ghost btn-sm" data-open-booking data-service={s.id}>{t(lang, 'pricing.book')}</button>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </details>
          );
        })}
      </div>
    </div>

    <!-- NAIL PANEL -->
    <div id="panel-nail" role="tabpanel" aria-labelledby="tab-nail" class="panel" data-panel="nail_services" hidden>
      <span id="pricing-nail" class="anchor"></span>

      <div class="nail-grid">
        {nailCats.map((cat) => {
          const items = servicesByCategory('nail_services', cat.id);
          if (items.length === 0) return null;
          return (
            <div class="nail-cat">
              <h3 class="nail-cat-title">{tx(cat.name, lang)}</h3>
              <div class="nail-items">
                {items.map((s) => {
                  const badge = badgeFor(s);
                  return (
                    <article class={`nail-card${s.tag ? ` nail-${s.tag}` : ''}`}>
                      <div class="nail-thumb" aria-hidden="true">
                        <span class="nail-tip"></span>
                      </div>
                      {badge && <span class={`badge ${badge.cls} nail-badge`}>{badge.label}</span>}
                      <h4 class="nail-name">{tx(s.name, lang)}</h4>
                      <p class="nail-desc">{tx(s.description, lang)}</p>
                      <div class="nail-foot">
                        <span class="nail-price">{formatPriceRange(s)}</span>
                        <button type="button" class="btn btn-accent btn-sm" data-open-booking data-service={s.id}>
                          {t(lang, 'pricing.book')}
                        </button>
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .anchor { display: block; position: relative; top: -80px; visibility: hidden; }

  /* ============ TABS ============ */
  .tabs {
    position: relative;
    display: inline-flex;
    margin: 0 auto var(--space-6);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 6px;
    width: fit-content;
    left: 50%; transform: translateX(-50%);
  }
  .tab {
    position: relative; z-index: 2;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    font-weight: 600; font-size: 0.95rem;
    color: var(--color-text-soft);
    transition: color var(--dur) var(--ease);
    white-space: nowrap;
  }
  .tab-active { color: #fff; }
  .tab-indicator {
    position: absolute; top: 6px; left: 6px; bottom: 6px;
    width: calc(50% - 6px);
    background: var(--color-primary);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-glow);
    transition: transform var(--dur) var(--ease), background var(--dur) var(--ease);
    z-index: 1;
  }
  .tabs[data-active="nail_services"] .tab-indicator { transform: translateX(100%); background: var(--color-accent); }

  /* ============ PANELS ============ */
  .panel { animation: fadeUp var(--dur-slow) var(--ease) both; }
  .panel[hidden] { display: none; }

  /* ============ RECOMMENDED ============ */
  .recommended { margin-bottom: var(--space-7); }
  .recommended-header { text-align: center; margin-bottom: var(--space-5); }
  .recommended-header h3 { margin-bottom: var(--space-2); font-size: 1.6rem; }
  .recommended-header p { color: var(--color-text-soft); }

  .recommended-grid {
    display: grid; gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .recommended-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .recommended-grid { grid-template-columns: repeat(4, 1fr); } }

  .rec-card {
    position: relative;
    display: flex; flex-direction: column;
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .rec-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
  .rec-popular { border-color: var(--color-popular); }
  .rec-best { border-color: var(--color-best); transform: scale(1.02); box-shadow: var(--shadow-md); }
  .rec-best:hover { transform: scale(1.02) translateY(-6px); }
  .rec-vip {
    background: linear-gradient(160deg, #fff 0%, #FFF6E5 100%);
    border-color: var(--color-vip);
    box-shadow: var(--shadow-md);
  }

  .rec-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); white-space: nowrap; }
  .rec-name { font-family: var(--font-title); font-size: 1.15rem; margin: var(--space-2) 0 4px; line-height: 1.25; }
  .rec-duration { font-size: 0.78rem; color: var(--color-text-muted); letter-spacing: 0.06em; text-transform: uppercase; }
  .rec-price {
    font-family: var(--font-title); font-weight: 700;
    font-size: clamp(2rem, 5vw, 2.6rem);
    color: var(--color-primary);
    margin: var(--space-3) 0 var(--space-2);
    line-height: 1;
  }
  .rec-vip .rec-price { color: var(--color-vip); }
  .rec-desc { font-size: 0.9rem; flex-grow: 1; margin-bottom: var(--space-4); }
  .rec-cta { width: 100%; justify-content: center; }
  .rec-vip .rec-cta { background: var(--color-vip); }
  .rec-vip .rec-cta:hover { background: #95743f; }

  /* ============ ACCORDION ============ */
  .accordion { display: flex; flex-direction: column; gap: var(--space-3); }
  .accordion-item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .accordion-summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-4) var(--space-5);
    display: flex; align-items: center; gap: var(--space-3);
    font-family: var(--font-title); font-size: 1.15rem; font-weight: 600;
  }
  .accordion-summary::-webkit-details-marker { display: none; }
  .accordion-summary > span:first-child { flex-grow: 1; }
  .accordion-count {
    font-family: var(--font-body); font-size: 0.78rem; font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg);
    padding: 2px 10px; border-radius: var(--radius-pill);
  }
  .accordion-icon {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--color-bg);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 1.4rem; line-height: 1; color: var(--color-primary);
    transition: transform var(--dur) var(--ease);
    font-weight: 300;
  }
  details[open] .accordion-icon { transform: rotate(45deg); }

  .service-list { list-style: none; margin: 0; padding: 0 var(--space-5) var(--space-4); }
  .service-row {
    display: flex; gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--color-border);
    align-items: center;
  }
  .service-row-main { flex-grow: 1; min-width: 0; }
  .service-row-head { display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; margin-bottom: 4px; }
  .service-row-name { font-weight: 600; color: var(--color-text); }
  .service-row-desc { margin: 0; font-size: 0.88rem; color: var(--color-text-soft); }
  .service-row-duration { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 2px; display: inline-block; }
  .service-row-side { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); flex-shrink: 0; }
  .service-row-price {
    font-family: var(--font-title); font-weight: 700; font-size: 1.25rem;
    color: var(--color-primary); white-space: nowrap;
  }

  /* ============ NAIL GRID ============ */
  .nail-grid { display: flex; flex-direction: column; gap: var(--space-7); }
  .nail-cat-title { font-size: 1.3rem; margin-bottom: var(--space-4); color: var(--color-accent-dark); display: flex; align-items: center; gap: var(--space-3); }
  .nail-cat-title::after { content: ''; flex-grow: 1; height: 1px; background: var(--color-border); }

  .nail-items {
    display: grid; gap: var(--space-3);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 720px) { .nail-items { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .nail-items { grid-template-columns: repeat(4, 1fr); } }

  .nail-card {
    position: relative;
    background: linear-gradient(170deg, #FFF8F2 0%, #FFEEDA 100%);
    border: 1px solid #F0DFC8;
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex; flex-direction: column;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    overflow: hidden;
  }
  .nail-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .nail-popular { border-color: var(--color-popular); }
  .nail-best { border-color: var(--color-best); }
  .nail-vip { background: linear-gradient(170deg, #FFF6E5 0%, #F0D9A6 100%); border-color: var(--color-vip); }

  .nail-thumb {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #F8C8B8 0%, #E8A8A0 50%, #C88080 100%);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-3);
    position: relative; overflow: hidden;
    display: flex; align-items: flex-end; justify-content: center;
    padding: 12px;
  }
  .nail-thumb::before {
    content: ''; position: absolute; top: -10%; left: -20%; right: -20%; height: 60%;
    background: radial-gradient(ellipse at center, rgba(255,255,255,0.55) 0%, transparent 70%);
    pointer-events: none;
  }
  .nail-tip {
    width: 60%; height: 70%;
    background: linear-gradient(180deg, rgba(255,255,255,0.4), rgba(255,255,255,0.1));
    border-radius: 50% 50% 14px 14px / 70% 70% 14px 14px;
    border: 1.5px solid rgba(255,255,255,0.6);
  }
  .nail-vip .nail-thumb { background: linear-gradient(135deg, #E5C97D 0%, #B08D57 100%); }
  .nail-best .nail-thumb { background: linear-gradient(135deg, #D8B4F8 0%, #8B5FBF 100%); }
  .nail-popular .nail-thumb { background: linear-gradient(135deg, #FFB6C1 0%, #FF6F91 100%); }

  .nail-badge { position: absolute; top: 12px; right: 12px; }
  .nail-name { font-family: var(--font-title); font-size: 1rem; line-height: 1.25; margin: 0 0 4px; }
  .nail-desc { font-size: 0.82rem; color: var(--color-text-soft); margin: 0 0 var(--space-3); flex-grow: 1; }
  .nail-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .nail-price { font-family: var(--font-title); font-weight: 700; font-size: 1.1rem; color: var(--color-accent-dark); white-space: nowrap; }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab');
  const tabsRoot = document.querySelector<HTMLElement>('.tabs');
  const panels = document.querySelectorAll<HTMLElement>('.panel');

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      if (!target || !tabsRoot) return;
      tabs.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('tab-active', isActive);
        b.setAttribute('aria-selected', String(isActive));
      });
      tabsRoot.dataset.active = target;
      panels.forEach((p) => {
        const match = p.dataset.panel === target;
        p.hidden = !match;
        p.classList.toggle('panel-active', match);
      });
    });
  });

  // Hash-based deep link to a tab (#pricing-nail / #pricing-spa)
  const activateFromHash = () => {
    const hash = location.hash;
    if (hash === '#pricing-nail') {
      (document.querySelector<HTMLButtonElement>('.tab[data-tab="nail_services"]'))?.click();
    } else if (hash === '#pricing-spa' || hash === '#pricing') {
      (document.querySelector<HTMLButtonElement>('.tab[data-tab="herbal_spa"]'))?.click();
    }
  };
  activateFromHash();
  window.addEventListener('hashchange', activateFromHash);
</script>
