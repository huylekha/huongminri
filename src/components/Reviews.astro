---
import type { Locale } from '../data/services';
import { tx } from '../data/services';
import { reviews } from '../data/reviews';
import { t } from '../i18n/translations';

interface Props { lang: Locale }
const { lang } = Astro.props;
---
<section class="section reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-title">
      <span class="section-eyebrow">{t(lang, 'reviews.eyebrow')}</span>
      <h2 id="reviews-title">{t(lang, 'reviews.title')}</h2>
    </div>
    <div class="reviews-track">
      {reviews.map((r) => (
        <figure class="review-card">
          <div class="review-stars" aria-label={`${r.rating} stars`}>
            {Array.from({ length: r.rating }).map(() => <span aria-hidden="true">★</span>)}
          </div>
          <blockquote>{tx(r.text, lang)}</blockquote>
          <figcaption>
            <strong>{r.name}</strong>
            {r.service && <span> · {r.service}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews-track {
    display: grid; gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .reviews-track { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .reviews-track { grid-template-columns: repeat(5, 1fr); } }
  @media (max-width: 719px) {
    .reviews-track {
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--space-3);
      -webkit-overflow-scrolling: touch;
    }
    .review-card { scroll-snap-align: start; }
  }

  .review-card {
    margin: 0; padding: var(--space-5);
    background: #fff; border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    display: flex; flex-direction: column; gap: var(--space-2);
  }
  .review-stars { color: #E5C97D; letter-spacing: 2px; }
  blockquote { margin: 0; font-style: italic; color: var(--color-text); flex-grow: 1; }
  figcaption { font-size: 0.88rem; color: var(--color-text-muted); }
  figcaption strong { color: var(--color-text); }
</style>
